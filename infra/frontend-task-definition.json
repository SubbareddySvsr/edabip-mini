{
  "family": "edabip-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::312920516006:role/EDABIP-ECS-Task-Execution-Role",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "312920516006.dkr.ecr.ap-south-1.amazonaws.com/edabip-frontend:18",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}